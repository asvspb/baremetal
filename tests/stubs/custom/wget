#!/usr/bin/env bash
# stub: wget — не качает: пишет локальный файл-пустышку при -O, иначе успех
if [[ -n "${STUB_LOG:-}" ]]; then
    printf '%s\n' "wget $* [cwd=$PWD]" >> "$STUB_LOG/wget.log"
fi
prev=""
for a in "$@"; do
    [[ "$prev" == "-O" && "$a" != -* ]] && : > "$a"
    [[ "$prev" == "-qO-" || "$prev" == "-qO" ]] && : # stdout-режим: пусто
    prev="$a"
done
exit 0
