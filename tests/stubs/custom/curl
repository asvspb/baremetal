#!/usr/bin/env bash
# stub: curl — не качает: при -o <файл> создаёт пустышку, иначе успех
if [[ -n "${STUB_LOG:-}" ]]; then
    printf '%s\n' "curl $* [cwd=$PWD]" >> "$STUB_LOG/curl.log"
fi
prev=""
for a in "$@"; do
    if [[ "$prev" == "-o" ]]; then
        : > "$a"
    fi
    prev="$a"
done
exit 0
